# ============================================================
# CALILI — variables de entorno (copia este archivo a .env.local)
# NUNCA subas .env.local a GitHub ni pegues claves en el chat.
# ============================================================

# --- Motor principal: ME AI (el pool propio; misma llave de EditCoreAI) ---
# Si esta llave existe, ME AI atiende chat, herramientas y visión, y el
# techo deja de ser el nivel gratuito de Groq. Pégala SOLO en tu .env.local
# y en Vercel (Secret) — nunca en el chat ni en GitHub.
MEAI_API_KEY=
# MEAI_MODEL=claude-sonnet-4.6
# MEAI_VISION_MODEL=glm-5.2

# --- Respaldo del motor (Groq) ---
# Crea una clave en https://console.groq.com/keys y pégala aquí.
GROQ_API_KEY=
# Modelo NEXUS servido por Groq:
NEXUS_MODEL=openai/gpt-oss-120b

# --- Motor NEXUS local (tu PC, desarrollo/respaldo) ---
# Descomenta según tu servidor local:
#   Ollama:    http://127.0.0.1:11434/v1
#   LM Studio: http://127.0.0.1:1234/v1
# NEXUS_LOCAL_URL=http://127.0.0.1:11434/v1
# NEXUS_LOCAL_MODEL=nexus
# NEXUS_LOCAL_API_KEY=

# Orden de proveedores: groq (defecto) o local
# NEXUS_PRIMARY=groq

# --- Backend: Supabase oficial de Calili (Fase 2) ---
# La clave anon sale de Supabase > Settings > API > anon public.
# La service_role NUNCA va aquí.
NEXT_PUBLIC_SUPABASE_URL=https://zspoeuvmreqyxahdfkyh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App ---
NEXT_PUBLIC_APP_NAME=Calili
NEXT_PUBLIC_APP_SHORT_NAME=Calili
NEXT_PUBLIC_APP_DESCRIPTION=Inteligencia artificial para conversar, crear, analizar y resolver
NEXT_PUBLIC_APP_URL=https://calili.vercel.app

# --- Estudio creativo de Google (AI Studio) ---
# UNA clave (https://aistudio.google.com/apikey) desbloquea: imagenes y
# EDICION de imagenes (Gemini Flash Image), VIDEO (Veo 3.1) y MUSICA
# (Lyria 3.5). Veo requiere facturacion activa en el proyecto de Google.
# Pegala AQUI en tu .env.local y en Vercel (Secret) — nunca en el chat.
GOOGLE_AI_API_KEY=
# Servicio de avatar auto-hospedado (LongCat-Video-Avatar en una maquina
# con GPU): URL publica del servicio y su token compartido. Sin URL, la
# herramienta de video hablado no se anuncia.
AVATAR_SERVICE_URL=
AVATAR_SERVICE_TOKEN=
<redacted>
# GOOGLE_VIDEO_MODEL=veo-3.1-fast-generate-preview

# OPCIONAL — OpenAI: desbloquea la voz clase ChatGPT (gpt-4o-mini-tts) y la
# EDICION directa de imagenes con gpt-image-1. Sin esta clave, Calili usa la
# voz Dalia y genera imagenes con el motor gratuito. Nunca la pegues en el chat.
# OPENAI_API_KEY=
# CALILI_OPENAI_VOICE=shimmer
