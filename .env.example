# ============================================================
# CALILI — variables de entorno (copia este archivo a .env.local)
# NUNCA subas .env.local a GitHub ni pegues claves en el chat.
# ============================================================

# --- Motor NEXUS en producción (Groq) ---
# Crea una clave en https://console.groq.com/keys y pégala aquí.
GROQ_API_KEY=
# Modelo NEXUS servido por Groq:
NEXUS_MODEL=openai/gpt-oss-120b

# --- Motor NEXUS local (tu PC, desarrollo/respaldo) ---
# Descomenta según tu servidor local:
#   Ollama:    http://127.0.0.1:11434/v1
#   LM Studio: http://127.0.0.1:1234/v1
# NEXUS_LOCAL_URL=http://127.0.0.1:11434/v1
# NEXUS_LOCAL_MODEL=nexus
# NEXUS_LOCAL_API_KEY=

# Orden de proveedores: groq (defecto) o local
# NEXUS_PRIMARY=groq

# --- Backend (ecosistema GAFCORE, esquema calili) ---
NEXT_PUBLIC_SUPABASE_URL=https://supabase.gafcore.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App ---
NEXT_PUBLIC_APP_NAME=Calili
NEXT_PUBLIC_APP_SHORT_NAME=Calili
NEXT_PUBLIC_APP_DESCRIPTION=Tu asistente AI personal
NEXT_PUBLIC_APP_URL=https://calili.vercel.app
